{
  "version": 2,
  "buildCommand": "cd design-system-storybook && npm ci && npm run build-storybook",
  "outputDirectory": "design-system-storybook/storybook-static",
  "installCommand": "echo 'skipping root install'",
  "cleanUrls": true,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
